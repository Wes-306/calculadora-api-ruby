<!-- app/views/home/index.html.erb -->
<div class="calculator-container">
  <h1>🧮 Calculadora API</h1>
  <p class="subtitle">Front-end consumindo a API Rails /api/v1/calculate</p>

  <form id="calculator-form">
    <div class="input-group">
      <label for="a">Primeiro Número (a):</label>
      <input type="number" id="a" step="any" required placeholder="Ex: 10">
    </div>

    <div class="input-group">
      <label for="operation">Operação:</label>
      <select id="operation" required>
        <option value="add">Somar (+)</option>
        <option value="subtract">Subtrair (-)</option>
        <option value="multiply">Multiplicar (*)</option>
        <option value="divide">Dividir (/)</option>
      </select>
    </div>

    <div class="input-group">
      <label for="b">Segundo Número (b):</label>
      <input type="number" id="b" step="any" required placeholder="Ex: 5">
    </div>

    <button type="submit" id="btn-calculate">Calcular</button>
  </form>

  <div id="result-box" class="result-box hidden">
    <h3>Resultado:</h3>
    <span id="result-value">0</span>
  </div>

  <div id="error-box" class="error-box hidden">
    <span id="error-message"></span>
  </div>
</div>

<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: #f4f6f8;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
  }

  .calculator-container {
    background: #ffffff;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    width: 100%;
    max-width: 400px;
  }

  h1 {
    margin-top: 0;
    color: #333;
    font-size: 1.5rem;
    text-align: center;
  }

  .subtitle {
    font-size: 0.85rem;
    color: #666;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .input-group {
    margin-bottom: 1rem;
  }

  label {
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 600;
    color: #444;
    font-size: 0.9rem;
  }

  input, select {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
    box-sizing: border-box;
  }

  button {
    width: 100%;
    padding: 0.75rem;
    background-color: #d32f2f; /* Vermelho Ruby */
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  button:hover {
    background-color: #b71c1c;
  }

  .result-box, .error-box {
    margin-top: 1.5rem;
    padding: 1rem;
    border-radius: 6px;
    text-align: center;
  }

  .result-box {
    background-color: #e8f5e9;
    border: 1px solid #c8e6c9;
    color: #2e7d32;
  }

  .result-box h3 {
    margin: 0 0 0.5rem 0;
    font-size: 0.9rem;
  }

  #result-value {
    font-size: 1.8rem;
    font-weight: bold;
  }

  .error-box {
    background-color: #ffebee;
    border: 1px solid #ffcdd2;
    color: #c62828;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('calculator-form');
    const resultBox = document.getElementById('result-box');
    const resultValue = document.getElementById('result-value');
    const errorBox = document.getElementById('error-box');
    const errorMessage = document.getElementById('error-message');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Oculta alertas anteriores
      resultBox.classList.add('hidden');
      errorBox.classList.add('hidden');

      // Coleta os valores do formulário
      const a = parseFloat(document.getElementById('a').value);
      const b = parseFloat(document.getElementById('b').value);
      const operation = document.getElementById('operation').value;

      try {
        // Envia a requisição assíncrona POST para a API em Rails
        const response = await fetch('/api/v1/calculate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer meu-token-secreto-de-desenvolvimento'
          },
          body: JSON.stringify({ operation, a, b })
        });

        const data = await response.json();

        if (response.ok) {
          resultValue.textContent = data.result;
          resultBox.classList.remove('hidden');
        } else {
          errorMessage.textContent = data.error || 'Erro ao realizar cálculo.';
          errorBox.classList.remove('hidden');
        }
      } catch (err) {
        errorMessage.textContent = 'Erro de conexão com a API.';
        errorBox.classList.remove('hidden');
      }
    });
  });
</script>